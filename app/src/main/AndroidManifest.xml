<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions for Timer & Background Execution on Modern Android (12, 13, 14, 15+) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Bắt buộc trên Android 11+ (targetSdk 30+) để kết nối dịch vụ Giọng đọc TextToSpeech (Google TTS / Samsung TTS) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <package android:name="com.google.android.tts" />
    </queries>

    <application
        android:name=".PowerTimerApplication"
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PowerTimer"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:theme="@style/Theme.PowerTimer">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Nhận link chia sẻ trực tiếp từ TikTok, Facebook, Instagram, YouTube, X... -->
            <intent-filter android:label="Tải Video (Tools Hub)">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- FileProvider để cài file APK cập nhật đã tải -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Foreground Service tải video ngầm với thông báo tiến trình -->
        <service
            android:name=".service.VideoDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Foreground Service with modern Android 14+ FGS type (mediaPlayback + specialUse cho Dynamic Island gốc hệ thống) -->
        <service
            android:name=".service.TimerForegroundService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Sleep and power off countdown timer service" />
        </service>

        <!-- Activity làm tối màn hình OLED 0% & tắt màn hình tự nhiên không cần Trợ năng (Chuẩn Ngân Hàng) -->
        <activity
            android:name=".ui.screens.BlackoutSleepActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen" />

        <!-- Màn hình Cuộc Gọi Giả (Fake Call) toàn màn hình y hệt cuộc gọi đến thật -->
        <activity
            android:name=".ui.screens.FakeCallIncomingActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showOnLockScreen="true"
            android:theme="@style/Theme.PowerTimer" />

        <receiver
            android:name=".ui.screens.FakeCallAlarmReceiver"
            android:exported="false" />

        <!-- Accessibility Service (Mặc định tắt/ẩn Component để App Ngân hàng không quét thấy) -->
        <service
            android:name=".service.PowerAccessibilityService"
            android:enabled="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Device Admin Receiver for instant lock screen (Sleep mode) -->
        <receiver
            android:name=".receiver.DeviceAdminSampleReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_sample" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Exact Alarm Receiver for reliable wakeup -->
        <receiver
            android:name=".receiver.TimerAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.vunameaut.powertimer.ACTION_TIMER_EXPIRED" />
            </intent-filter>
        </receiver>

        <!-- Mini Soundbox: Đọc số tiền nhận chuyển khoản từ thông báo Ngân hàng & MoMo -->
        <service
            android:name=".service.MoneySoundboxService"
            android:label="Loa Báo Nhận Tiền (Tools Hub)"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Bộ 4 Nút Bấm Nhanh trên Thanh Trạng Thái (Quick Settings Tiles) -->
        <service
            android:name=".service.SleepTimerTileService"
            android:label="Hẹn giờ Màn hình"
            android:icon="@mipmap/ic_launcher"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".service.ScannerOcrTileService"
            android:label="Quét QR / OCR"
            android:icon="@mipmap/ic_launcher"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".service.MyVietQrTileService"
            android:label="Mã VietQR Của Tôi"
            android:icon="@mipmap/ic_launcher"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".service.ClipboardVideoTileService"
            android:label="Tải Video Clipboard"
            android:icon="@mipmap/ic_launcher"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Tiện ích ngoài Màn hình chính (Home Screen Widgets) -->
        <receiver
            android:name=".widget.ToolsHubAppWidgetProvider"
            android:label="Bộ 4 Công Cụ Nhanh (Tools Hub)"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.vunameaut.powertimer.widget.ACTION_TOGGLE_TIMER" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_tools_hub_info" />
        </receiver>

        <receiver
            android:name=".widget.VietQrAppWidgetProvider"
            android:label="Mã VietQR Cá Nhân (Tools Hub)"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_my_vietqr_info" />
        </receiver>

    </application>

</manifest>
