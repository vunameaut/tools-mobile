<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_lunar_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_dark"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Thanh tiêu đề & Điều hướng Tháng ngay trên Màn hình chính -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/widget_lunar_header_click"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_lunar_month_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:text="🗓️ THÁNG 11 / 2026"
                android:textColor="#22D3EE"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_lunar_today_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:text="Hôm nay: 15/11 DL • 06/10 ÂL (Bính Ngọ)"
                android:textColor="#CBD5E1"
                android:textSize="10.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_lunar_btn_prev"
            android:layout_width="32dp"
            android:layout_height="28dp"
            android:background="@drawable/widget_btn_bg"
            android:gravity="center"
            android:text="◀"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_lunar_btn_today"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_btn_bg"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="Hôm nay"
            android:textColor="#4ADE80"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_lunar_btn_next"
            android:layout_width="32dp"
            android:layout_height="28dp"
            android:background="@drawable/widget_btn_bg"
            android:gravity="center"
            android:text="▶"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Lưới Lịch Tháng Âm - Dương sắc nét -->
    <ImageView
        android:id="@+id/widget_lunar_grid_image"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="Lịch Âm Dương"
        android:scaleType="fitXY"
        android:src="@drawable/lunar_widget_preview" />

</LinearLayout>

