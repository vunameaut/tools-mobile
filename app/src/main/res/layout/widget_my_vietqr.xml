<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_vietqr_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_dark"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/widget_vietqr_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:singleLine="true"
        android:text="🏦 VIETQR CỦA TÔI"
        android:textColor="#4ADE80"
        android:textSize="11sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/widget_vietqr_image"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="4dp"
        android:background="#FFFFFF"
        android:contentDescription="Mã VietQR"
        android:padding="4dp"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/widget_vietqr_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:singleLine="true"
        android:text="Chạm để thiết lập STK"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>

